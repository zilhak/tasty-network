allow	crates/tasty-net-rendezvous/src/wire/stun.rs	const PUNCH_TOKEN_LEN: usize = 16	와이어 형식: 펀칭 토큰 16 B
allow	crates/tasty-net-rendezvous/src/wire/stun.rs	const COMPREHENSION_OPTIONAL_MIN: u16 = 0x8000	와이어 형식: 0x8000 미만 속성은 이해 필수
allow	crates/tasty-net-rendezvous/src/wire/stun.rs	const ATTR_HEADER_LEN: usize = 4	와이어 형식: STUN 속성 머리 4 B
allow	crates/tasty-net-rendezvous/src/wire/stun.rs	const ATTR_ALIGN: usize = 4	와이어 형식: STUN 속성 4 B 정렬
allow	crates/tasty-net-rendezvous/src/wire/stun.rs	const FAMILY_V4: u8 = 0x01	와이어 형식: 주소족 IPv4 0x01
